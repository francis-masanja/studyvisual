# --- Turso (required) --------------------------------------------------------
VITE_TURSO_URL=
VITE_TURSO_AUTH_TOKEN=
# Note: VITE_TURSOR_API_KEY is also supported as a fallback for the auth token
VITE_TURSOR_API_KEY=

# --- AI / LLM (optional) -----------------------------------------------------
# Any Ollama or OpenAI-compatible endpoint works. AI features stay hidden when
# OLLAMA_BASE_URL is unset.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional: setting an API key switches to OpenAI-compatible /v1/chat/completions mode
OLLAMA_API_KEY=
